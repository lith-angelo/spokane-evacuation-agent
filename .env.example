# Inference provider. Swap these two lines to point at a Nemotron Lightning NIM.
EVAC_INFERENCE_BASE_URL=http://127.0.0.1:8000/v1
EVAC_INFERENCE_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
EVAC_INFERENCE_API_KEY=not-needed

# OpenShell egress
EVAC_SANDBOX=my-assistant
EVAC_OPENSHELL_BIN=/home/acer01/.local/bin/openshell
EVAC_NEMOCLAW_BIN=/home/acer01/.local/bin/nemoclaw
EVAC_EGRESS_CONCURRENCY=8

# Degraded mode. Leave unset in the demo: when the sandbox is unavailable the
# agent should say so rather than silently fetching ungoverned.
# ALLOW_HOST_DIRECT_FALLBACK=1

# live | replay
EVAC_DATA_MODE=replay
EVAC_DB_PATH=./data/sessions.sqlite3
