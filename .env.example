# Local NVIDIA Nemotron Lightning served through vLLM's OpenAI-compatible API.
EVAC_INFERENCE_BASE_URL=http://127.0.0.1:8000/v1
EVAC_INFERENCE_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
EVAC_INFERENCE_API_KEY=not-needed

# Optional dynamic location and routing. Keep the token in .env only.
MAPBOX_ACCESS_TOKEN=
# Mapbox supplies address autocomplete/geocoding. OSRM supplies routing because
# its encoded-polyline form is compatible with OpenShell's L7 path parser.
EVAC_LOCATION_PROVIDER=mapbox
EVAC_ROUTE_PROVIDER=osrm
# In replay mode, keep hazard feeds deterministic but resolve the entered
# address and calculate its routes live through the egress policy.
EVAC_LIVE_LOCATION_IN_REPLAY=1

# Environmental evidence. Both services are free but require registered keys.
# For the contained runtime, attach generic OpenShell providers and leave only
# these opaque placeholders in the process environment. The proxy resolves the
# real values at request time; do not commit real keys.
OPENAQ_API_KEY=openshell:resolve:env:OPENAQ_API_KEY
FIRMS_MAP_KEY=openshell:resolve:env:FIRMS_MAP_KEY
EVAC_AIR_QUALITY_TTL_SECONDS=7200
EVAC_AIR_QUALITY_STATION_RADIUS_KM=25
EVAC_AIR_QUALITY_MEDICAL_THRESHOLD=35.5
# A thermal detection older than six hours is retained as stale evidence but
# is not presented as a current detection.
EVAC_FIRMS_HOTSPOT_TTL_SECONDS=21600

# OpenShell egress
EVAC_SANDBOX=my-assistant
EVAC_OPENSHELL_BIN=/home/acer01/.local/bin/openshell
EVAC_NEMOCLAW_BIN=/home/acer01/.local/bin/nemoclaw
EVAC_EGRESS_CONCURRENCY=8
# Set only for the deployed harness process running inside OpenShell. In this
# mode direct child processes remain sandboxed; no nested NemoClaw call occurs.
EVAC_INSIDE_OPENSHELL=0
# Replay is a synthetic hackathon demo. Clear addresses, household needs and
# traces whenever the process starts instead of accumulating participant data.
EVAC_PURGE_DEMO_DATA_ON_START=1

# Degraded mode. Leave unset in the demo: when the sandbox is unavailable the
# agent should say so rather than silently fetching ungoverned.
# ALLOW_HOST_DIRECT_FALLBACK=1

# live | replay
EVAC_DATA_MODE=replay
EVAC_DB_PATH=./data/sessions.sqlite3
